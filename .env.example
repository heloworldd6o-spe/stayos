# StayOS Production & Development Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Settings
DATABASE_PATH=server/db/stayos.db

# Authentication
JWT_SECRET=stayos_super_secret_jwt_key_enterprise_pg_2026
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay / Stripe / PhonePe / Cashfree HMAC integration)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY=rzp_test_stayos_mock_key
PAYMENT_GATEWAY_SECRET=stayos_payment_gateway_hmac_secret_2026
PAYMENT_WEBHOOK_SECRET=stayos_webhook_secret_2026

# Messaging & Notification Providers
NOTIFICATION_PROVIDER=console
EMAIL_API_KEY=mock_sendgrid_or_resend_api_key
WHATSAPP_API_KEY=mock_meta_whatsapp_cloud_api_key
SMS_API_KEY=mock_twilio_or_fast2sms_api_key

# File Storage Provider (local / s3 / cloudinary)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=server/uploads
STORAGE_S3_BUCKET=stayos-private-documents
STORAGE_S3_REGION=ap-south-1

# Background Automations & Cron Service
CRON_ENABLED=true
CRON_INTERVAL_MS=3600000
